[gd_scene format=3]

[ext_resource type="Script" path="res://ui/SettingsMenu.cs" id="1_settings"]

[node name="SettingsMenu" type="PanelContainer"]
visible = false
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -220.0
offset_top = -190.0
offset_right = 220.0
offset_bottom = 190.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_settings")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 12

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Settings"
horizontal_alignment = 1

[node name="Rows" type="GridContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 8
columns = 2

[node name="Done" type="Button" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Done"
